<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_influencer_contract_list" model="ir.ui.view">
        <field name="name">influencer.contract.list</field>
        <field name="model">influencer.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="business_partner_id"/>
                <field name="influencer_id"/>
                <field name="contract_status"/>
                <field name="contract_type"/>
                <field name="contract_value"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="business_signed"/>
                <field name="influencer_signed"/>
            </list>
        </field>
    </record>

    <record id="view_influencer_contract_form" model="ir.ui.view">
        <field name="name">influencer.contract.form</field>
        <field name="model">influencer.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contract reference"/>
                        </h1>
                    </div>
                    <group string="Contract Basics">
                        <group>
                            <field name="campaign_id"/>
                            <field name="contract_type"/>
                        </group>
                        <group>
                            <field name="contract_status"/>
                        </group>
                    </group>
                    <group string="Parties">
                        <group>
                            <field name="business_partner_id"/>
                        </group>
                        <group>
                            <field name="influencer_id"/>
                        </group>
                    </group>
                    <group string="Value &amp; Dates">
                        <group>
                            <field name="contract_value"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Agreement">
                        <field name="deliverables" nolabel="1" placeholder="Deliverables"/>
                        <field name="terms" nolabel="1" placeholder="Terms and conditions"/>
                    </group>
                    <group string="Signatures">
                        <group>
                            <field name="business_signed"/>
                            <field name="business_signed_at"/>
                        </group>
                        <group>
                            <field name="influencer_signed"/>
                            <field name="influencer_signed_at"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Internal notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_influencer_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">influencer.contract</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

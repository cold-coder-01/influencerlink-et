<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_influencer_campaign_list" model="ir.ui.view">
        <field name="name">influencer.campaign.list</field>
        <field name="model">influencer.campaign</field>
        <field name="arch" type="xml">
            <list string="Campaigns">
                <field name="name"/>
                <field name="business_name"/>
                <field name="influencer_id"/>
                <field name="industry_id"/>
                <field name="platform"/>
                <field name="campaign_goal"/>
                <field name="budget_range"/>
                <field name="status"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="roi_multiplier"/>
            </list>
        </field>
    </record>

    <record id="view_influencer_campaign_form" model="ir.ui.view">
        <field name="name">influencer.campaign.form</field>
        <field name="model">influencer.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Campaign name"/>
                        </h1>
                    </div>
                    <group string="Campaign Basics">
                        <group>
                            <field name="partner_id"/>
                            <field name="business_name"/>
                            <field name="campaign_goal"/>
                        </group>
                        <group>
                            <field name="platform"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Matching">
                        <group>
                            <field name="influencer_id"/>
                            <field name="industry_id"/>
                        </group>
                        <group>
                            <field name="roi_multiplier"/>
                            <field name="location_focus"/>
                        </group>
                    </group>
                    <group string="Budget &amp; Dates">
                        <group>
                            <field name="budget_range"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Campaign description"/>
                        <field name="campaign_notes" nolabel="1" placeholder="Internal notes"/>
                    </group>
                    <group string="Escrow">
                        <group>
                            <field name="currency_id"/>
                            <field name="escrow_balance"/>
                        </group>
                        <group>
                            <field name="escrow_status"/>
                            <field name="promo_code"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_influencer_campaign_search" model="ir.ui.view">
        <field name="name">influencer.campaign.search</field>
        <field name="model">influencer.campaign</field>
        <field name="arch" type="xml">
            <search string="Campaigns">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="industry_id"/>
                <field name="business_name"/>
                <field name="campaign_goal"/>
                <field name="platform"/>
                <field name="status"/>
                <field name="promo_code"/>
                <filter
                    name="funded"
                    string="Funded"
                    domain="[('escrow_status', '=', 'funded')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_status"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />
                    <filter
                        name="group_by_industry"
                        string="Industry"
                        context="{'group_by': 'industry_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_influencer_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">influencer.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_influencer_message_list" model="ir.ui.view">
        <field name="name">influencer.message.list</field>
        <field name="model">influencer.message</field>
        <field name="arch" type="xml">
            <list string="Messages">
                <field name="created_at"/>
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="sender_partner_id"/>
                <field name="receiver_partner_id"/>
                <field name="influencer_id"/>
                <field name="message_type"/>
                <field name="direction"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>

    <record id="view_influencer_message_form" model="ir.ui.view">
        <field name="name">influencer.message.form</field>
        <field name="model">influencer.message</field>
        <field name="arch" type="xml">
            <form string="Message">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Message subject"/>
                        </h1>
                    </div>
                    <group string="Message Info">
                        <group>
                            <field name="campaign_id"/>
                            <field name="message_type"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="is_read"/>
                            <field name="read_at"/>
                            <field name="created_at"/>
                        </group>
                    </group>
                    <group string="Participants">
                        <group>
                            <field name="sender_partner_id"/>
                            <field name="receiver_partner_id"/>
                        </group>
                        <group>
                            <field name="influencer_id"/>
                        </group>
                    </group>
                    <group string="Body">
                        <field name="body" nolabel="1" placeholder="Message body"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_influencer_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">influencer.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
